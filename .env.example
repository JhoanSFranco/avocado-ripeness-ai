# Copy to `.env` and adjust. Every value below is optional (defaults shown).
# Never commit your real `.env` file.

# --- Server -------------------------------------------------------------------
# HOST=0.0.0.0
# PORT=8000
# LOG_LEVEL=INFO
# Comma-separated browser origins allowed by CORS (only needed when the
# frontend calls the API from a different origin).
# CORS_ORIGINS=http://localhost:3000

# --- Model --------------------------------------------------------------------
# MODEL_PATH=models/avocado_ripeness_resnet50.pth
# DEVICE=auto            # auto | cpu | cuda | cuda:0
# MC_SAMPLES=8           # Monte Carlo Dropout passes per photo (>= 2)

# --- Confidence thresholds (top-1 probability) ---------------------------------
# CONFIDENCE_HIGH=0.70
# CONFIDENCE_MEDIUM=0.50

# --- Optional LLM insights (https://console.groq.com) ---------------------------
# Without a key the API uses built-in rule-based advice.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_TIMEOUT_SECONDS=20

# --- Sessions & uploads ---------------------------------------------------------
# SESSION_TTL_SECONDS=3600
# MAX_SESSIONS=1000
# MAX_IMAGES_PER_SESSION=10
# MAX_UPLOAD_MB=10
# FEEDBACK_PATH=data/feedback/feedback.csv
